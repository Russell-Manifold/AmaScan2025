<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AmaScan.ReceivingDocumentsPage"
             Title="Receiving Documents">
    <VerticalStackLayout Padding="20" Spacing="5">
        <Label Text="Receiving PO:" FontAttributes="Bold" />
        <Label Text="{Binding OrderNo}" FontSize="20" FontAttributes="Bold" />
       
        <Label Text="Into Warehouse" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
            <Label x:Name="WarehouseLabel" Text="{Binding SelectedWarehouseDescription}" FontAttributes="Bold" VerticalOptions="Center" Grid.Column="0" />
            <Button Text="Change" Clicked="OnChangeWarehouseClicked" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="1" FontSize="Small" />
        </Grid>
        <Picker x:Name="WarehousePicker"
                ItemsSource="{Binding WarehouseList}"
                ItemDisplayBinding="{Binding Description}"
                SelectedItem="{Binding SelectedWarehouse}"
                IsVisible="False" />
        
        <Label Text="Delivery Note Number" />
        <Entry x:Name="DeliveryNoteEntry" Placeholder="Delivery Note Number" Text="{Binding DNnumber}" />

        <Label Text="Supplier Invoice Number" />
        <Entry x:Name="InvoiceNumberEntry" Placeholder="Supplier Invoice Number" Text="{Binding SuppInvNumber}" />
        <ActivityIndicator x:Name="loadingIndicator" IsVisible="False" IsRunning="False" />

        <Button Text="Start Receiving"
                Clicked="OnAcceptClicked"
                BackgroundColor="Green"
                TextColor="White" />

    </VerticalStackLayout>
</ContentPage>