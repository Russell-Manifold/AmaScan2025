<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AmaScan.Controls"
             x:Class="AmaScan.ReturnsPage"
             Title="Returns">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="resumeimg.png" Clicked="OnRestartClicked" Order="Primary" Priority="1" />
    </ContentPage.ToolbarItems>

    <!-- Root Grid allows ScrollView + Overlay to stack on top of each other -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="2">

                <!-- Warehouse -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <Label Grid.Column="0" Text="Warehouse:" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" Margin="0,0,6,0"/>
                    <Label Grid.Column="1" Text="{Binding ReturnsWarehouse}" FontSize="14" VerticalOptions="Center"/>
                </Grid>

                <!-- SO Number -->
                <Label Text="SO Number (Optional)" FontSize="13" TextColor="Gray"/>
                <Entry x:Name="soEntry" Placeholder="SO Number" FontSize="14" Margin="0,2,0,6"/>

                <!-- Barcode + Manual Input Toggle in same row -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <Label Grid.Column="0" Text="Barcode" FontSize="13" TextColor="Gray" VerticalOptions="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Manual" FontSize="12" TextColor="Gray" VerticalOptions="Center"/>
                        <Switch
                            x:Name="ManualInputSwitch"
                            IsToggled="False"
                            Toggled="OnManualInputToggled"
                            VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
                <controls:NoKeyboardEntry
                    x:Name="BarcodeEntry"
                    Placeholder="Scan barcode"
                    MaxLength="15"
                    Keyboard="Numeric"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    Focused="OnBarcodeFocused"
                    Unfocused="OnBarcodeUnfocused"
                    TextChanged="OnBarcodeCompleted"
                    Completed="OnBarcodeEntryCompleted"
                    Margin="0,2,0,4"/>

                <!-- Description -->
                <Label x:Name="DescriptionLabel"
                    Text="Scan a barcode to see item description"
                    FontSize="13"
                    TextColor="Gray"
                    FontAttributes="Italic"
                    Margin="0,0,0,6"/>

                <!-- Quantity -->
                <Label Text="Quantity" FontSize="13" TextColor="Gray"/>
                <Entry
                    x:Name="QuantityEntry"
                    Placeholder="Enter quantity"
                    Keyboard="Numeric"
                    MaxLength="6"
                    HorizontalOptions="Fill"
                    TextChanged="QuantityEntry_TextChanged"
                    Margin="0,2,0,6"/>

                <!-- Reason -->
                <Label Text="Return Reason" FontSize="13" TextColor="Gray"/>
                <Picker x:Name="ddReason"
                    Title="Select Reason"
                    SelectedItem="{Binding SelectedReturnReason}"
                    ItemsSource="{Binding ReturnReasons}"
                    HorizontalOptions="Fill"
                    Margin="0,2,0,6"/>

                <!-- Comments -->
                <Label Text="Comments" FontSize="13" TextColor="Gray"/>
                <Editor x:Name="Comments"
                    Placeholder="Optional comments"
                    MinimumHeightRequest="70"
                    MaxLength="250"
                    AutoSize="TextChanges"
                    Margin="0,2,0,10"/>

                <!-- Process Button -->
                <Button
                    x:Name="ProcessReturnButton"
                    Text="Process Return"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="15"
                    HorizontalOptions="Fill"
                    Clicked="OnSaveProgressClicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay sits on top of ScrollView, covers full screen -->
        <Grid x:Name="LoadingOverlay"
            IsVisible="False"
            BackgroundColor="Black"
            Opacity="0.5">
            <ActivityIndicator x:Name="loadingIndicator"
                IsRunning="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="White"
                Scale="1.5"/>
        </Grid>

    </Grid>
</ContentPage>