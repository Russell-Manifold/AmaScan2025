<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AmaScan.Controls"
             x:Class="AmaScan.ReturnsPage"
             Title="Returns">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="resumeimg.png" Clicked="OnRestartClicked" Order="Primary" Priority="1" />
    </ContentPage.ToolbarItems>

    <!-- Root Grid allows ScrollView + Overlay to stack on top of each other -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="4">

                <!-- Warehouse -->
                <Label Text="Warehouse:" FontAttributes="Bold" FontSize="18"/>
                <Label Text="{Binding ReturnsWarehouse}" FontSize="18" Margin="0,0,0,10"/>

                <!-- SO Number -->
                <Label Text="SO Number" FontSize="18"/>
                <Entry x:Name="soEntry" Placeholder="(Optional)" FontSize="18" Margin="0,0,0,10"/>

                <!-- Barcode -->
                <Label Text="Barcode" FontSize="18"/>
                <controls:NoKeyboardEntry
                    x:Name="BarcodeEntry"
                    Placeholder="Barcode"
                    MaxLength="15"
                    Keyboard="Numeric"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    Focused="OnBarcodeFocused"
                    Unfocused="OnBarcodeUnfocused"
                    TextChanged="OnBarcodeCompleted"
                    Margin="0,0,0,10"/>

                <!-- Description -->
                <Label x:Name="DescriptionLabel" Text="Description" Margin="0,0,0,10"/>

                <!-- Manual Input -->
                <Label Text="Manual Input" FontSize="18"/>
                <Switch
                    x:Name="ManualInputSwitch"
                    IsToggled="False"
                    Toggled="OnManualInputToggled"
                    HorizontalOptions="Start"
                    Margin="0,0,0,10"/>

                <!-- Quantity -->
                <Label Text="Quantity" FontSize="18"/>
                <Entry
                    x:Name="QuantityEntry"
                    Placeholder="Qty"
                    Keyboard="Numeric"
                    MaxLength="6"
                    HorizontalOptions="Start"
                    TextChanged="QuantityEntry_TextChanged"
                    MinimumWidthRequest="80"
                    MaximumWidthRequest="80"
                    Focused="QuantityEntry_Focused"
                    Margin="0,0,0,10"/>

                <!-- Reason -->
                <Label Text="Reason" FontSize="18"/>
                <Picker x:Name="ddReason"
                    Title="Select Reason"
                    SelectedItem="{Binding SelectedReturnReason}"
                    ItemsSource="{Binding ReturnReasons}"
                    HorizontalOptions="Fill"
                    Margin="0,0,0,10"/>

                <!-- Comments -->
                <Label Text="Comments" FontSize="18"/>
                <Editor x:Name="Comments"
                    Placeholder="Comments"
                    MinimumHeightRequest="100"
                    MaxLength="250"
                    AutoSize="TextChanges"
                    Margin="0,0,0,20"/>

                <!-- Process Button -->
                <Button
                    x:Name="ProcessReturnButton"
                    Text="Process Return"
                    BackgroundColor="Green"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    Clicked="OnSaveProgressClicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay sits on top of ScrollView, covers full screen -->
        <Grid x:Name="LoadingOverlay"
            IsVisible="False"
            BackgroundColor="Black"
            Opacity="0.5">
            <ActivityIndicator x:Name="loadingIndicator"
                IsRunning="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="White"
                Scale="1.5"/>
        </Grid>

    </Grid>
</ContentPage>