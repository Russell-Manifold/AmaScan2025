<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AmaScan"
             x:Class="AmaScan.CheckingDocumentsPage"
             Title="Checking Items">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">
        <!-- SO Header Info -->
        <Frame Grid.Row="0" Padding="10" BackgroundColor="LightGray" Margin="0,0,0,10">
            <VerticalStackLayout>
                <Label Text="{Binding SoNumber, StringFormat='SO: {0}'}" FontSize="18" FontAttributes="Bold"/>
                <Label Text="{Binding CustomerName}" FontSize="14"/>
                <Label Text="{Binding DueDate, StringFormat='Due Date: {0:d}'}" FontSize="12"/>
            </VerticalStackLayout>
        </Frame>

        <Label Grid.Row="1" 
               Text="Click on an item below to select it for checking:" 
               FontSize="16" 
               FontAttributes="Bold"
               Margin="5,0,0,5"/>

        <!-- SO Items List -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding SoLines}"
                              SelectionMode="Single"
                              SelectionChanged="OnSoLineSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="0,5" 
                                   BackgroundColor="{Binding StatusColor}"
                                   BorderColor="LightGray">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" 
                                                          CommandParameter="{Binding}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding ItemDesc}" FontAttributes="Bold" />
                                        <Label Text="{Binding ItemCode, StringFormat='Item Code: {0}'}" />
                                        <Label Text="{Binding ItemBarcode, StringFormat='Barcode: {0}'}" />
                                        <Label Text="{Binding OrderedQty, StringFormat='Ordered Qty: {0}'}" />
                                        <Label Text="{Binding DiscrepancyStatus}" 
                                               TextColor="Red"
                                               IsVisible="{Binding ShowDiscrepancyStatus}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding PickedQty, StringFormat='Picked: {0}'}" 
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding PackedQty, StringFormat='Packed: {0}'}" 
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding CheckedQty, StringFormat='Checked: {0}'}" 
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
    </Grid>
</ContentPage> 