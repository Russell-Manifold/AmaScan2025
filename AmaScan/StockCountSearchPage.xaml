<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AmaScan.Controls"
             x:Class="AmaScan.StockCountSearchPage"
             Title="Search Stock Count Item">

    <Grid RowDefinitions="Auto,*" Padding="20">
        <!-- Header Info -->
        <Frame Grid.Row="0" Padding="10" BackgroundColor="LightGrey" Margin="0,0,0,10">
            <VerticalStackLayout>
                <Label Text="Scan or enter barcode to find item to count."/>
            </VerticalStackLayout>
        </Frame>

        <!-- Search Section -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="10">
                <Grid ColumnDefinitions="*,80" Padding="10,5" RowDefinitions="Auto,Auto">
                    <Label Grid.Column="0" Text="Barcode:" />
                    <controls:NoKeyboardEntry x:Name="BarcodeEntry" 
                                            Placeholder="Enter barcode" 
                                            Completed="OnBarcodeEntered" 
                                            MaxLength="15" 
                                            Keyboard="Numeric" 
                                            Grid.Row="1" Grid.Column="0" 
                                            FontSize="18" />
                </Grid>
                
                <Grid ColumnDefinitions="*,Auto" Padding="10,0">
                    <Label Grid.Column="0" Text="Manual" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Start" />
                    <Switch Grid.Column="1" x:Name="ManualInputSwitch" 
                            IsToggled="False"
                            Toggled="OnManualInputToggled" 
                            HorizontalOptions="End"
                            VerticalOptions="Center" />
                </Grid>
                
                <Button x:Name="SearchButton" 
                        Text="Search" 
                        BackgroundColor="Blue"
                        TextColor="White"
                        Margin="10,0"
                        Clicked="OnSearchClicked" />

                <!-- Search Results -->
                <Frame x:Name="SearchResultFrame" 
                       Padding="10" 
                       Margin="10,5" 
                       BackgroundColor="{Binding StatusColor}"
                       BorderColor="LightGray"
                       IsVisible="False">
                    <StackLayout>
                        <Label x:Name="ResultStockDescription" FontAttributes="Bold" />
                        <Label x:Name="ResultStockCode" />
                        <Label x:Name="ResultStatus" 
                               TextColor="Red"
                               IsVisible="False"/>
                    </StackLayout>
                </Frame>
                
                <Button x:Name="StartCountingButton" 
                        Text="Start Counting" 
                        BackgroundColor="DarkGreen"
                        TextColor="White"
                        Margin="10,0"
                        Clicked="OnStartCountingClicked" />
            </StackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          x:Name="LoadingIndicator"
                          IsRunning="False"
                          IsVisible="False"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
    </Grid>
</ContentPage> 